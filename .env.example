# CryptoCheck AI — local development
# Copy to .env.local and fill in values from your Supabase project dashboard.

# Supabase (required for auth / dashboard — app loads without these, sign-in will not work)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (caching, reputation ledger, rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Solana RPC (scans degrade without HELIUS_API_KEY)
HELIUS_API_KEY=

# B2B smoke tests (optional)
B2B_TEST_API_KEY=
B2B_TEST_SECRET=

# Internal fast scan / crons
CRON_SECRET=

# Trading / portfolio API probes (optional)
TEST_API_KEY=

# Web4 Launchpad (Solana bonding curve)
# After: ./scripts/deploy-web4-devnet.sh
NEXT_PUBLIC_WEB4_PROGRAM_ID=DjGTVwckj7649JhWomSaC89vTrD4abrvSpejFQS2armL

# Optional: server RPC for protocol stats / indexing
HELIUS_RPC_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Protocol metrics (landing stats bar)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

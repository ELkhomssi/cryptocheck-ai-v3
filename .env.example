# ═══════════════════════════════════════════════════════════════════════════════
# CryptoCheck AI — environment template
# Copy to `.env.local` at this project root and fill in values.
# Next.js loads `.env.local` automatically (`next dev` / `next build` / `next start`).
# Restart the dev server after any change.
# NEVER commit `.env.local` — it is gitignored.
# ═══════════════════════════════════════════════════════════════════════════════

# ── P0 — Command center /dashboard (feed, auth, caches) ─────────────────────
# Without these: anonymous preview only, empty feed, reconnect pill, scans degraded.

# Auth + entitlements (Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for middleware page_views (falls back to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=
# Salt for page_views.ip_address SHA-256 — never store raw IPs
IP_HASH_SALT=

# Redis — signal history, fee ledger, rate limits (Upstash console)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live signal feed — Next.js app proxies history; browser opens WebSocket
# Local: run `services/realtime` on port 4102 (see services/realtime/.env.example)
# Signal feed — Vercel-only (no Railway): leave SIGNAL_REALTIME_URL unset.
# History reads Supabase `signal_normalized`; UI polls every ~20s.
# Optional: set SIGNAL_REALTIME_URL + NEXT_PUBLIC_SIGNAL_WS_URL only if you host
# the external realtime gateway (Railway/Render/Fly).
# SIGNAL_REALTIME_URL=
# SIGNAL_REALTIME_PORT=4102
# NEXT_PUBLIC_SIGNAL_WS_URL=
# SIGNAL_FEED_MODE=poll
# SIGNAL_POLL_INTERVAL_MS=20000

# HMAC for internal signal routes (generate a random string; match workers)
SIGNAL_WORKER_SECRET=

# ── P1 — Token scanner (right rail Scan + /api/revenue/scan) ─────────────────

# Helius dashboard → API Keys (server-only; do NOT prefix with NEXT_PUBLIC_)
HELIUS_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── P2 — Pro upgrade, AI, push ──────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe dashboard (secret key = server only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly products + prices ($10 / $20)
STRIPE_PRODUCT_BASIC=prod_UnIXGE2yq617IB
STRIPE_PRODUCT_PRO=prod_UnIZspIvaC74wR
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
# Annual products + prices ($100 / $200). Annual lives on its own Stripe product.
# If the *_PRICE_*_ANNUAL vars are unset, checkout resolves the product's yearly
# recurring price via the Stripe API. Setting the price_ ids explicitly is faster.
STRIPE_PRODUCT_BASIC_ANNUAL=prod_UqkGDoEsPAXpTc
STRIPE_PRODUCT_PRO_ANNUAL=prod_UqkHBDsdEFPbk3
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_YEARLY=

# OpenAI — server actions / analyze-contract only
OPENAI_API_KEY=

# Web push (signals subscribe)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@cryptocheckai.com

# ── P3 — Trading / revenue dashboard ─────────────────────────────────────────

NEXT_PUBLIC_PLATFORM_FEE_BPS=50
# Prefer authority (derives output-mint ATA). Legacy fixed ATA still supported.
NEXT_PUBLIC_PLATFORM_FEE_AUTHORITY=
# NEXT_PUBLIC_PLATFORM_FEE_ACCOUNT=
# PLATFORM_FEE_TOKEN_ACCOUNT=
# Server-only: must match authority pubkey — used to idempotently create fee ATAs
# PLATFORM_FEE_AUTHORITY_SECRET=
SIGNAL_PREMIUM_PRICE_USD=29
SIGNAL_PREMIUM_MERCHANT_WALLET=

# Personal watch + coach (continuous rescans of watchlist ∪ portfolio holdings)
# PERSONAL_WATCH_INTERVAL_MIN=10
# PERSONAL_WATCH_MAX_MINTS_PER_TICK=80

# ── LaunchLAB (token create) — landing product-map CTA reads these server-side ─
# Live CTA only when ENABLED and NOT paused. Otherwise: waitlist copy.
# NEXT_PUBLIC_LAUNCH_MODE_ENABLED=false
# LAUNCH_MODE_PAUSED=true
# LAUNCH_MODE_ALLOW_MAINNET=false
# LAUNCHLAB_CLUSTER=devnet
# LAUNCHLAB_PLATFORM_ID=

# Admin / diagnostics gate
DIAGNOSTICS_ADMIN_EMAILS=
DIAGNOSTICS_ADMIN_SECRET=
ADMIN_WALLETS=

# ── Sentinel Edge agent (alerts ticker / agent tape) ─────────────────────────

SIGNAL_AGENT_ENABLED=true
SIGNAL_AGENT_MODE=paper
SIGNAL_AGENT_KILL_SWITCH=false
SIGNAL_AGENT_SIGNING_KEY=

# ── Proof Engine (gate-worker — token calls track record) ────────────────────
# DRY_RUN=true logs selections only; set false after audit. AUTO_POST enables Telegram.

PROOF_ENGINE_ENABLED=false
PROOF_ENGINE_DRY_RUN=true
PROOF_ENGINE_AUTO_POST=false
PROOF_ENGINE_DANGER_MAX_SCORE=25
PROOF_ENGINE_SAFE_MIN_SCORE=80
PROOF_ENGINE_SMART_MONEY_MIN_SOURCES=3
# TELEGRAM_PROOF_BOT_TOKEN=
# TELEGRAM_PROOF_CHANNEL_ID=@your_public_channel
# SIGNAL_AGENT_PROOF_LIVE=true
# SIGNAL_AGENT_SOLANA_SECRET=[...]

# ── Data sources strip (/api/dashboard/command-center/sources) ───────────────
# Live channel count comes from Redis heartbeat (telegram-monitor on Railway).
# Fallback: SIGNAL_TELEGRAM_CHANNEL_COUNT or services/ingestion/config/channels.json

# TxODDS live chip (app env — workers use TXLINE_* in services/ingestion)
TXODDS_ENABLED=
TXODDS_API_KEY=

# Optional override when workers are offline (dev only)
SIGNAL_TELEGRAM_CHANNEL_COUNT=
SIGNAL_CHANNELS_CONFIG=

# Telegram on Railway (services/ingestion — not loaded by Next.js)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=   # alias: TELEGRAM_SESSION

# AI Signal Source Agent (services/ingestion — auto-discovers alpha sources)
# Multi-platform: Telegram + X/Twitter. Runs on telegram-monitor boot; also
# standalone via `npm run scout` (cron). Requires the platform-column migration
# (supabase/migrations/20260708_source_platform.sql).
# SCOUT_ENABLED=true                 # master switch for all platforms
# SCOUT_DRY_RUN=false                # true = report what it would enroll, no writes
# SCOUT_MIN_REPUTATION=80            # shared reputation floor (0..100) unless overridden
# SCOUT_MAX_INSERTS=25               # cap new sources enrolled per platform per run
#
# Scout Discovery Agent (trust loop — Node, same ingestion process)
# Requires: supabase/migrations/20260711_signal_channel_metrics.sql
# SIGNAL_DISCOVERY_ENABLED=true      # hourly discovery loop (default on when telegram enabled)
# SIGNAL_DISCOVERY_INTERVAL_MS=3600000
# SIGNAL_CHANNEL_MAX_LISTEN=200      # GramJS join cap (trust-ranked). Toward 1k: raise + SIGNAL_SESSION_COUNT sharding
# SCOUT_MAX_INSERTS=250              # enroll up to N new channels per discovery run
# SCOUT_MIN_REPUTATION=70
# SCOUT_TELEGRAM_REQUIRE_VERIFICATION=false
# SCOUT_TELEGRAM_SEEDS_PATH=config/telegram-discovery-seeds.json
# SCOUT_TELEGRAM_SEARCH_API_URL=     # optional TGStat-style API to push past ~300 seeds toward 1k+
# SIGNAL_CHANNEL_TRUST_LISTEN_FLOOR=35
# SIGNAL_CHANNEL_TRUST_DISABLE_FLOOR=25
# SIGNAL_CHANNEL_DANGER_RATE_DISABLE=0.65
# SIGNAL_CHANNEL_METRICS_MIN_SAMPLES=8
#
# Telegram platform
# SCOUT_TELEGRAM_ENABLED=true
# SCOUT_MIN_SUBSCRIBERS=10000        # min Telegram subscribers
# SCOUT_TELEGRAM_REQUIRE_VERIFICATION=true
# SCOUT_TELEGRAM_MIN_REPUTATION=     # optional per-platform override
# SCOUT_TELEGRAM_SEARCH_API_URL=     # optional external discovery endpoint
# SCOUT_TELEGRAM_SEARCH_API_KEY=
#
# X / Twitter platform
# SCOUT_TWITTER_ENABLED=true
# SCOUT_MIN_FOLLOWERS=100000         # min X followers
# SCOUT_TWITTER_REQUIRE_VERIFICATION=true
# SCOUT_TWITTER_MIN_REPUTATION=      # optional per-platform override
# SCOUT_TWITTER_SEARCH_API_URL=      # optional external discovery endpoint
# SCOUT_TWITTER_SEARCH_API_KEY=

# ── AI Sniper engine (services/sniper — detector, non-custodial) ──────────────
# Market-wide detector: new launch → Scanner (kill-switch) → emit snipe candidate.
# NEVER signs or moves funds; per-user arming + Phantom signing is client-side.
# SNIPER_ENABLED=true                  # false = health only, no consuming
# SCANNER_URL=http://scanner:4103      # Scanner microservice base URL
# SNIPER_MIN_SCORE=70                  # min neuralScore (0..100) to emit a candidate
# SNIPER_TRIGGER_TYPES=buy             # comma list of token event types that trigger
# SNIPER_SCAN_TIMEOUT_MS=4000          # per-scan timeout (fails safe → blocked)
# SNIPER_LOG_ALL_SCANS=false           # true also writes every scan to signal_snipe_actions
# SNIPER_BATCH=10
# SNIPER_BLOCK_MS=3000
# ── Sniper execution layer (Next.js side — /api/signals/snipe/*) ──
# SNIPER_MAX_AMOUNT_SOL=5              # hard ceiling per single snipe (SOL)
# SNIPER_MAX_AMOUNT_USD=500           # arm-state cap ceiling (USD)
# Institutional OMS (lib/execution) — capital + sim + safety on prepare / sniper
# Default ON for sniper when unset. Set false to use legacy build-swap only.
# EXEC_OMS_ENABLED=true
# EXEC_JITO_ENABLED=false
# EXEC_JITO_BUNDLE_SUBMIT=false   # true = server sendBundle + poll before RPC fallback
# EXEC_JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1
# EXEC_JITO_BASE_TIP_LAMPORTS=0
# EXEC_PRIORITY_FEE_LAMPORTS=0
# SNIPER_ARM_TTL_SEC=43200            # Full-Auto auto-disarms after this (12h)

# ── Crons & internal probes ───────────────────────────────────────────────────

CRON_SECRET=
TEST_API_KEY=

# ── B2B smoke tests (optional, local audit only) ─────────────────────────────

B2B_TEST_API_KEY=
B2B_TEST_SECRET=
B2B_TEST_RUG_MINT=

# ═══════════════════════════════════════════════════════════════════════════════
# Signal workers (separate processes — NOT loaded by Next.js automatically)
# Copy and fill:
#   services/ingestion/.env.example  → Telegram + TxODDS ingestion
#   services/pipeline/.env.example   → parse / enrich / gate / agent
#   services/realtime/.env.example   → WebSocket gateway (port 4102)
# Share UPSTASH_*, SUPABASE_SERVICE_ROLE_KEY, SIGNAL_WORKER_SECRET across all.
# ═══════════════════════════════════════════════════════════════════════════════

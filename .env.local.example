# Copy to `.env.local` at the repo root. Never commit real keys.
# Minimal set for Phase 10 terminal + portfolio desk providers.
# Provider API keys are SERVER-ONLY — never prefix with NEXT_PUBLIC_.

# ── Helius (RPC / DAS / webhooks) ───────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_RPC_URL=
# Optional shared secret for POST /api/webhooks/helius (and /api/webhooks/helius-portfolio)
# HELIUS_WEBHOOK_SECRET=

# ── Market data providers (optional — empty results when unset) ─────────────
# JUPITER_API_KEY=
# BIRDEYE_API_KEY=
# COINGECKO_API_KEY=

# ── Terminal OS v6 live feeds (/terminalOS) ─────────────────────────────────
# CoinGecko + DexScreener work without keys (public free tiers).
# Optional upgrades:
# WHALE_ALERT_API_KEY=          # real wallet whale txs; else DexScreener volume flows
# NEXT_PUBLIC_TERMINAL_OS_WHALE_WS_URL=  # optional WS; else SSE /api/terminal-os/whales/stream + poll
# ETHERSCAN_API_KEY=            # EVM large-transfer enrichment (future)
# BSCSCAN_API_KEY=
# BASESCAN_API_KEY=
# HELIUS_API_KEY=               # Solana on-chain holders / wallet activity
# BIRDEYE_API_KEY=              # richer Solana candles / screener when present

# ── Provider quotas (optional overrides; defaults are conservative free-tier) ─
# Soft threshold ~75–85% of limit → delay requests; hard limit → stop safely.
# BIRDEYE_RPM=40
# BIRDEYE_DAILY_QUOTA=8000
# JUPITER_RPM=120
# JUPITER_DAILY_QUOTA=50000
# HELIUS_RPM=300
# HELIUS_DAILY_QUOTA=100000
# COINGECKO_RPM=25
# COINGECKO_DAILY_QUOTA=9000
# RAYDIUM_RPM=60
# RAYDIUM_DAILY_QUOTA=30000
# DEXSCREENER_RPM=50
# DEXSCREENER_DAILY_QUOTA=20000
# ANTHROPIC_RPM=30
# ANTHROPIC_DAILY_QUOTA=2000

# ── Redis (provider TTL cache + rate limits) ────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── AI Coach streaming ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase (persist alerts / portfolio — migration: 20260724_portfolio_alerts.sql)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

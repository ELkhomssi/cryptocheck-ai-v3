# Signal worker env — copy to deploy/.env.signal on the droplet ONLY.
#   cp deploy/.env.signal.example deploy/.env.signal && chmod 600 deploy/.env.signal
# NEVER commit deploy/.env.signal (real secrets).
#
# Worker naming uses SUPABASE_URL (not NEXT_PUBLIC_SUPABASE_URL).
# Values must match the same Supabase + Upstash project as Vercel Production.

# ── Redis (Upstash) — streams + heartbeats ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase — scout enrolls telegram_channels; gate writes signal_normalized ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel app bridge (gate token assess) ─────────────────────────────────────
SIGNAL_ASSESS_URL=https://www.cryptocheckai.com
SIGNAL_WORKER_SECRET=
# Must match Vercel Production SIGNAL_WORKER_SECRET exactly.

# ── Ingestion sources ────────────────────────────────────────────────────────
# Comma-separated. Supported today: telegram | txodds
# Same container runs both — no separate twitter/txodds compose service.
# twitter live ingestion is NOT implemented (scout-only); do not set SIGNAL_SOURCES=twitter.
SIGNAL_SOURCES=telegram

# ── Telegram (GramJS) — session generated LOCALLY, never interactively on server
#   cd services/ingestion && npm run auth
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Optional file fallback when telegram_channels is empty (image ships empty list)
SIGNAL_CHANNELS_CONFIG=services/ingestion/config/channels.json
SIGNAL_SESSION_INDEX=0
SIGNAL_SESSION_COUNT=1
SIGNAL_INGESTION_HEALTH_PORT=4101
SIGNAL_STREAM_UNIFIED_MAXLEN=100000

# ── TxODDS / TxLINE (same ingestion container — no new service) ───────────────
# 1. Activate authorized access: https://txline.txodds.com/documentation/worldcup
# 2. Set TXLINE_API_TOKEN (this is the API key — there is no TXODDS_API_KEY var)
# 3. Set SIGNAL_SOURCES=telegram,txodds  (or txodds alone)
# 4. Restart: docker compose -p cryptocheck-signal -f deploy/docker-compose.signal.yml up -d ingestion
#
# TXLINE_API_ORIGIN=https://txline.txodds.com
# TXLINE_API_TOKEN=
# TXLINE_JWT=                 # optional; empty → guest JWT via /auth/guest/start
# TXLINE_STREAM_MODE=both     # scores | odds | both
# TXLINE_FIXTURE_IDS=         # optional comma-separated fixture IDs
# TXLINE_FIXTURE_REFRESH_MS=3600000
# TXLINE_RECONNECT_BASE_MS=2000
# TXLINE_RECONNECT_MAX_MS=60000

# ── AI Channel Scout (runs once on ingestion boot) ───────────────────────────
# Enrolls PUBLIC handles into telegram_channels — does NOT stream tweets.
# Twitter scout needs 20260708_source_platform.sql (platform column) applied.
SCOUT_ENABLED=true
SCOUT_DRY_RUN=false
SCOUT_MIN_REPUTATION=80
SCOUT_MAX_INSERTS=25
SCOUT_TELEGRAM_ENABLED=true
SCOUT_MIN_SUBSCRIBERS=10000
SCOUT_TELEGRAM_REQUIRE_VERIFICATION=true
# SCOUT_TELEGRAM_SEARCH_API_URL=
# SCOUT_TELEGRAM_SEARCH_API_KEY=
SCOUT_TWITTER_ENABLED=false
# SCOUT_TWITTER_MIN_REPUTATION=80
# SCOUT_TWITTER_REQUIRE_VERIFICATION=true
# SCOUT_TWITTER_SEARCH_API_URL=
# SCOUT_TWITTER_SEARCH_API_KEY=

# ── Gate worker ──────────────────────────────────────────────────────────────
SIGNAL_GATE_CONSUMER=gate-droplet-1
SIGNAL_GATE_BATCH=10
SIGNAL_GATE_BLOCK_MS=3000
SIGNAL_GATE_HEALTH_PORT=4105

# Sentinel agent (paper mode default — no autonomous trades)
SIGNAL_AGENT_ENABLED=false
SIGNAL_AGENT_KILL_SWITCH=true
SIGNAL_AGENT_MODE=paper
SIGNAL_AGENT_SIGNING_KEY=
# Must match Vercel Production SIGNAL_AGENT_SIGNING_KEY if agent features enabled.

# Proof engine — enable only after feed verification passes
PROOF_ENGINE_ENABLED=false
PROOF_ENGINE_DRY_RUN=true
PROOF_ENGINE_AUTO_POST=false

# Optional LLM parse fallback (ingestion normalize path)
# OPENAI_API_KEY=
# SIGNAL_LLM_MODEL=gpt-4o-mini
# SIGNAL_LLM_MIN_REGEX_CONFIDENCE=0.7

{
  "name": "cryptocheck-ai",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "packages/signing",
    "packages/types",
    "packages/ccai-connect",
    "packages/ccai-pay",
    "packages/extension",
    "packages/signal-contracts",
    "services/ingestion",
    "services/pipeline",
    "services/realtime",
    "services/scanner",
    "services/sniper"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:packages && next build",
    "build:packages": "npm run build --prefix packages/signing && npm run build --prefix packages/types && npm run build --prefix packages/ccai-connect && npm run build --prefix packages/signal-contracts",
    "start": "next start",
    "lint": "next lint",
    "test:sentinel": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/test-sentinel.ts",
    "test:intelligence": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/smoke-intelligence.ts",
    "test:portfolio-alerts": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/smoke-portfolio-alerts.ts",
    "test:key-store": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/test-key-store.ts",
    "test:terminal-reducer": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/test-terminal-reducer.ts",
    "test:api-probe": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/test-api.ts",
    "test:verdict-thresholds": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/test-verdict-thresholds.ts",
    "test:proof-calls": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/smoke-proof-calls.ts",
    "audit:post-migration": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/audit-post-migration.ts",
    "audit:ci": "npm run audit:post-migration && cat docs/audit-results.md",
    "verify:all-phases": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/verify-all-phases.ts",
    "create:launch-platform": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/create-platform.ts",
    "create:referral-ata": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node scripts/create-referral-ata.ts",
    "verify:landing-honesty": "node --import tsx scripts/verify-landing-honesty.ts",
    "deploy:signals": "bash scripts/deploy-signals-production.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.101",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.170",
    "@coral-xyz/anchor": "^0.32.1",
    "@cryptocheck/ccai-connect": "workspace:*",
    "@cryptocheck/signal-contracts": "file:packages/signal-contracts",
    "@cryptocheck/signing": "workspace:*",
    "@cryptocheck/types": "workspace:*",
    "@raydium-io/raydium-sdk-v2": "^0.2.59-alpha",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.168",
    "axios": "^1.18.1",
    "bn.js": "^5.2.5",
    "chart.js": "^4.4.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^1.8.0",
    "next": "14.2.5",
    "openai": "^4.104.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "stripe": "^22.0.2",
    "swr": "^2.4.1",
    "three": "^0.128.0",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.128.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "madge": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}

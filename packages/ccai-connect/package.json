{
  "name": "@cryptocheck/ccai-connect",
  "version": "1.0.0",
  "description": "CCAI Connect SDK — institutional risk API for DEXs, wallets, and trading terminals",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build --prefix ../signing && tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cryptocheck/signing": "file:../signing"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}

# Signal Aggregator workers — build from repo root:
#   docker build -f services/Dockerfile.signal-worker --build-arg SERVICE=ingestion -t ccai-signal-ingestion .
#   docker build -f services/Dockerfile.signal-worker --build-arg SERVICE=gate -t ccai-signal-gate .
#
# SERVICE selects which worker to build/run (smaller images for droplet deploy).

FROM node:22-alpine AS build
WORKDIR /app
ARG SERVICE=ingestion

COPY packages/signal-contracts ./packages/signal-contracts
RUN npm ci --prefix packages/signal-contracts 2>/dev/null || npm install --prefix packages/signal-contracts
RUN npm run build --prefix packages/signal-contracts

COPY packages/signing ./packages/signing
RUN npm ci --prefix packages/signing 2>/dev/null || npm install --prefix packages/signing
RUN npm run build --prefix packages/signing

COPY services ./services

RUN set -e; case "$SERVICE" in \
  ingestion) \
    npm ci --prefix services/ingestion 2>/dev/null || npm install --prefix services/ingestion; \
    npm run build --prefix services/ingestion ;; \
  gate) \
    npm ci --prefix services/pipeline 2>/dev/null || npm install --prefix services/pipeline; \
    npm run build --prefix services/pipeline ;; \
  parser|enrich) \
    npm ci --prefix services/pipeline 2>/dev/null || npm install --prefix services/pipeline; \
    npm run build --prefix services/pipeline ;; \
  realtime) \
    npm ci --prefix services/realtime 2>/dev/null || npm install --prefix services/realtime; \
    npm run build --prefix services/realtime ;; \
  scanner) \
    npm ci --prefix services/scanner 2>/dev/null || npm install --prefix services/scanner; \
    npm run build --prefix services/scanner ;; \
  sniper) \
    npm ci --prefix services/sniper 2>/dev/null || npm install --prefix services/sniper; \
    npm run build --prefix services/sniper ;; \
  *) echo "Unknown SERVICE=$SERVICE" && exit 1 ;; \
 esac

FROM node:22-alpine
WORKDIR /app
ARG SERVICE=ingestion
ENV SIGNAL_SERVICE=${SERVICE}
ENV SIGNAL_CHANNELS_CONFIG=services/ingestion/config/channels.json

COPY --from=build /app/packages/signal-contracts /app/packages/signal-contracts
COPY --from=build /app/packages/signing /app/packages/signing
COPY --from=build /app/services/ingestion /app/services/ingestion
COPY --from=build /app/services/pipeline /app/services/pipeline

CMD ["sh", "-c", "case \"$SIGNAL_SERVICE\" in ingestion) exec node services/ingestion/dist/index.js ;; gate) exec node services/pipeline/dist/gate/index.js ;; parser) exec node services/pipeline/dist/parser/index.js ;; enrich) exec node services/pipeline/dist/enrich/index.js ;; realtime) exec node services/realtime/dist/index.js ;; scanner) exec node services/scanner/dist/index.js ;; sniper) exec node services/sniper/dist/index.js ;; *) echo \"Unknown SIGNAL_SERVICE=$SIGNAL_SERVICE\" && exit 1 ;; esac"]

# Telegram API — https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Upstash Redis (Streams)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ingestion sources (comma-separated): telegram, txodds
SIGNAL_SOURCES=telegram

# TxLINE / TxODDS (when txodds in SIGNAL_SOURCES)
# Complete World Cup free-tier activation first: https://txline.txodds.com/documentation/worldcup
TXLINE_API_ORIGIN=https://txline.txodds.com
TXLINE_JWT=
TXLINE_API_TOKEN=
TXLINE_STREAM_MODE=both
# Optional comma-separated fixture filter (empty = all stream events)
TXLINE_FIXTURE_IDS=
TXLINE_FIXTURE_REFRESH_MS=3600000
TXLINE_RECONNECT_BASE_MS=2000
TXLINE_RECONNECT_MAX_MS=60000

# Optional
SIGNAL_CHANNELS_CONFIG=config/channels.json
SIGNAL_INGESTION_HEALTH_PORT=4101
SIGNAL_SESSION_INDEX=0
SIGNAL_SESSION_COUNT=1
SIGNAL_STREAM_RAW_MAXLEN=100000
SIGNAL_STREAM_UNIFIED_MAXLEN=100000
SIGNAL_LLM_MODEL=gpt-4o-mini
SIGNAL_LLM_MIN_REGEX_CONFIDENCE=0.7
OPENAI_API_KEY=

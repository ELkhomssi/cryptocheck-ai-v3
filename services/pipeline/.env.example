UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (persist signal_normalized)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gateway assess bridge (Next.js app must be reachable)
SIGNAL_ASSESS_URL=http://localhost:3000
SIGNAL_WORKER_SECRET=

# Optional LLM fallback (parser only)
OPENAI_API_KEY=
SIGNAL_LLM_MODEL=gpt-4o-mini
SIGNAL_LLM_MIN_REGEX_CONFIDENCE=0.7

SIGNAL_PARSER_CONSUMER=parser-1
SIGNAL_PARSER_BATCH=20
SIGNAL_PARSER_BLOCK_MS=3000
SIGNAL_PARSER_HEALTH_PORT=4103

SIGNAL_ENRICH_CONSUMER=enrich-1
SIGNAL_ENRICH_BATCH=10
SIGNAL_ENRICH_BLOCK_MS=3000
SIGNAL_ENRICH_HEALTH_PORT=4104
SIGNAL_FEED_CACHE_SIZE=500

# Unified gate — consumes ccai:sig:stream:unified
SIGNAL_GATE_CONSUMER=gate-1
SIGNAL_GATE_BATCH=10
SIGNAL_GATE_BLOCK_MS=3000
SIGNAL_GATE_HEALTH_PORT=4105

# Sentinel Edge AgentEngine — opt-in autonomous decisions
SIGNAL_AGENT_ENABLED=false
SIGNAL_AGENT_KILL_SWITCH=false
SIGNAL_AGENT_MODE=paper
SIGNAL_AGENT_ID=sentinel-edge-1
SIGNAL_AGENT_EDGE_THRESHOLD=40
SIGNAL_AGENT_CONFIDENCE_FLOOR=0.55
SIGNAL_AGENT_MAX_SIZE=10
SIGNAL_AGENT_PER_MATCH_CAP=25
SIGNAL_AGENT_DAILY_LOSS_LIMIT=50
SIGNAL_AGENT_DETECTORS=latency_edge,line_velocity,model_divergence
SIGNAL_AGENT_SIGNING_KEY=
SIGNAL_AGENT_PUBKEY=

# On-chain proof — Memo commitments (paper mode default)
SIGNAL_AGENT_PROOF_LIVE=false
SIGNAL_AGENT_SOLANA_SECRET=
SIGNAL_AGENT_RPC_URL=https://api.devnet.solana.com

# Realtime gateway (history + WS fan-out)
SIGNAL_REALTIME_URL=http://localhost:4102
NEXT_PUBLIC_SIGNAL_WS_URL=ws://localhost:4102
